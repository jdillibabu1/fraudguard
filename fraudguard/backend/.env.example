# ---- Database (SQLite locally; swap for PostgreSQL later) ----
DATABASE_URL=sqlite:///./fraudguard.db
# PostgreSQL example: postgresql+psycopg2://user:password@localhost:5432/fraudguard

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Rule configuration ----
VELOCITY_TRANSACTION_LIMIT=5
VELOCITY_WINDOW_MINUTES=5
VELOCITY_SCORE=30
HIGH_AMOUNT_THRESHOLD=200000
UNUSUAL_AMOUNT_SCORE=35
MAX_TRAVEL_SPEED_KMH=900
IMPOSSIBLE_LOCATION_SCORE=45

# ---- Risk levels / notifications ----
FLAG_THRESHOLD=30
NOTIFY_THRESHOLD=60

# ---- Notifications: auto | console | aws ----
NOTIFICATION_BACKEND=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
SNS_TOPIC_ARN=
SES_FROM_EMAIL=
SES_TO_EMAIL=
